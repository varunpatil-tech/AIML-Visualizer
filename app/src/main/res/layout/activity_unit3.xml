<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_dashboard_header">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIML VISUALIZER  /  MODULE 03"
                android:textColor="#B9E8FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Neural Networks\nand Expert Systems"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/unit3ProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_unit_number"
                android:text="Topic 1 of 11"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Topic selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Explore the syllabus"
            android:textColor="#172B4D"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Select a topic to study its foundations, explanation, and examples."
            android:textColor="#66758A"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_unit_button"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECT A TOPIC"
                android:textColor="#0786A0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <Spinner
                android:id="@+id/unit3TopicSpinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4263A5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <!-- Topic explanation card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_unit_button"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/unit3CategoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEURAL NETWORKS"
                android:textColor="#0786A0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/unit3TitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Biological Neurons"
                android:textColor="#172B4D"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- Prerequisite foundations -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="PREREQUISITE FOUNDATIONS"
                android:textColor="#4263A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/unit3FoundationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Prerequisites appear here."
                android:textColor="#334155"
                android:textSize="15sp" />

            <!-- Concept explanation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CONCEPT EXPLANATION"
                android:textColor="#4263A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/unit3ExplanationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:text="Concept explanation appears here."
                android:textColor="#334155"
                android:textSize="15sp" />

            <!-- Example -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="REAL-WORLD EXAMPLE"
                android:textColor="#4263A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/unit3ExampleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="14dp"
                android:background="#E3EEFF"
                android:lineSpacingExtra="4dp"
                android:text="Example appears here."
                android:textColor="#24509A"
                android:textSize="15sp" />

            <!-- Key takeaway -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="KEY TAKEAWAY"
                android:textColor="#26734D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/unit3TakeawayText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="14dp"
                android:background="#E0F5EA"
                android:lineSpacingExtra="4dp"
                android:text="Key takeaway appears here."
                android:textColor="#176B45"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Topic navigation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CONTINUE LEARNING"
            android:textColor="#66758A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/unit3PreviousButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_unit_button"
                android:backgroundTint="@null"
                android:text="← Previous"
                android:textAllCaps="false"
                android:textColor="#24509A"
                android:textStyle="bold"
                android:elevation="1dp" />

            <Button
                android:id="@+id/unit3NextButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_unit_number"
                android:backgroundTint="@null"
                android:text="Next Topic →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:elevation="2dp" />

        </LinearLayout>

        <!-- Interactive perceptron lab -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="HANDS-ON EXPERIMENT"
            android:textColor="#0786A0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/unit3NetworkLabButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_unit_number"
            android:backgroundTint="@null"
            android:text="Open Neural Network Training Lab"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:elevation="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Interactive Perceptron Lab"
            android:textColor="#172B4D"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Change inputs, weights, bias, and threshold to see how a perceptron makes a binary decision."
            android:textColor="#66758A"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- Inputs and weights -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_unit_button"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INPUTS AND WEIGHTS"
                android:textColor="#4263A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Each input is paired with a weight. Add or remove pairs to experiment."
                android:textColor="#66758A"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/unit3InputRowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/unit3AddInputButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#26734D"
                    android:text="+ Add Input"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/unit3RemoveInputButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#B54747"
                    android:text="- Remove Input"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Bias -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Bias (b)"
                android:textColor="#263957"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/unit3BiasEdit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#4263A5"
                android:hint="Enter bias"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:singleLine="true"
                android:text="0"
                android:textColor="#172B4D" />

            <!-- Threshold -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Activation Threshold"
                android:textColor="#263957"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/unit3ThresholdEdit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#4263A5"
                android:hint="Enter threshold"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:singleLine="true"
                android:text="0"
                android:textColor="#172B4D" />

            <!-- Formula -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#EDF2FA"
                android:padding="14dp"
                android:text="NET INPUT&#10;z = Σ(xᵢ × wᵢ) + b&#10;&#10;ACTIVATION RULE&#10;Output = 1 if z ≥ threshold; otherwise output = 0."
                android:textColor="#263957"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/unit3CalculateButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_unit_number"
                android:backgroundTint="@null"
                android:text="Calculate Perceptron Output"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:elevation="2dp" />

        </LinearLayout>

        <!-- Result -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CALCULATION RESULT"
            android:textColor="#4263A5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/unit3PerceptronResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_unit_button"
            android:elevation="2dp"
            android:padding="18dp"
            android:text="Output: 1"
            android:textColor="#17365D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Step-by-step explanation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="STEP-BY-STEP EXPLANATION"
            android:textColor="#4263A5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/unit3PerceptronStepsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_unit_button"
            android:elevation="2dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:text="Calculation steps will appear here."
            android:textColor="#263957"
            android:textIsSelectable="true"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
