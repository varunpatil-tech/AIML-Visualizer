<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A* Search Visualizer"
            android:textColor="#172B55"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Experiment with heuristics and observe how A* searches."
            android:textColor="#52627A"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#DFE9FF"
            android:gravity="center"
            android:padding="16dp"
            android:text="f(n) = g(n) + h(n)"
            android:textColor="#173B83"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="g(n): cost so far   •   h(n): estimated cost remaining   •   f(n): total estimated cost"
            android:textColor="#33466B"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="1. Search Graph"
            android:textColor="#172B55"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.example.aiml_project.AStarGraphView
            android:id="@+id/graphView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="2. Edit Heuristic Values"
            android:textColor="#172B55"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Change the estimated remaining cost h(n) for each node. Default values are shown below."
            android:textColor="#52627A"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="h(S)"
                android:textColor="#172B55"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/heuristicSInput"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true"
                android:text="5"
                android:selectAllOnFocus="true"
                android:hint="0" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="h(A)"
                android:textColor="#172B55"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/heuristicAInput"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true"
                android:text="3"
                android:selectAllOnFocus="true"
                android:hint="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="h(B)"
                android:textColor="#172B55"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/heuristicBInput"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true"
                android:text="5"
                android:selectAllOnFocus="true"
                android:hint="0" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="h(C)"
                android:textColor="#172B55"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/heuristicCInput"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true"
                android:text="4"
                android:selectAllOnFocus="true"
                android:hint="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="h(G)"
                android:textColor="#172B55"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/heuristicGInput"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:inputType="number"
                android:singleLine="true"
                android:text="0"
                android:selectAllOnFocus="true"
                android:hint="0" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF0DD"
            android:padding="12dp"
            android:text="Learning tip: for the usual optimality guarantee, use non-negative heuristic estimates that do not overestimate the true remaining cost. h(G) is normally 0."
            android:textColor="#8D4A16"
            android:textSize="13sp" />

        <Button
            android:id="@+id/runAStarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Run A* with These Values"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="3. Step-by-Step Demonstration"
            android:textColor="#172B55"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#172B55"
            android:padding="14dp"
            android:text="Ready to begin"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/explanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Press Next Step to begin."
            android:textColor="#26364F"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="OPEN LIST"
            android:textColor="#167541"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#E4F5EA"
            android:padding="12dp"
            android:text="Discovered nodes waiting to be explored."
            android:textColor="#286343"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/openListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:minHeight="54dp"
            android:padding="14dp"
            android:text="OPEN: { empty }"
            android:textColor="#174D31"
            android:textSize="15sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CLOSED LIST"
            android:textColor="#B45D19"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFF0DD"
            android:padding="12dp"
            android:text="Nodes that have already been explored."
            android:textColor="#8D4A16"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/closedListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:minHeight="54dp"
            android:padding="14dp"
            android:text="CLOSED: { empty }"
            android:textColor="#8D4A16"
            android:textSize="15sp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/nextStepButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next Step"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Reset Defaults"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
