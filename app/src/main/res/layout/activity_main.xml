<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero section -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashboard_header"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#263D5C"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="✦  AI LEARNING PLATFORM"
                android:textColor="#67E8F9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="AIML&#10;VISUALIZER."
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Understand AI. See it work."
                android:textColor="#67E8F9"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Explore algorithms, experiment with models, and turn concepts into understanding."
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <View
                android:layout_width="52dp"
                android:layout_height="4dp"
                android:layout_marginTop="22dp"
                android:background="#22D3EE" />

        </LinearLayout>

        <!-- Summary -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR LEARNING SPACE"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Explore the syllabus"
                    android:textColor="#172554"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_unit_number"
                android:gravity="center"
                android:text="06&#10;UNITS"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Unit list heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="LEARNING MODULES"
            android:textColor="#172554"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:text="Choose a unit to start learning"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Unit 1 -->

        <Button
            android:id="@+id/unit1Button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:gravity="center_vertical|start"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="01    Heuristic Search Techniques     ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Unit 2 -->

        <Button
            android:id="@+id/unit2Button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:gravity="center_vertical|start"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="02    Learning and Planning     ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Unit 3 -->

        <Button
            android:id="@+id/unit3Button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:gravity="center_vertical|start"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="03    Neural Networks and Expert Systems     ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Unit 4 -->

        <Button
            android:id="@+id/unit4Button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:gravity="center_vertical|start"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="04    Introduction to Machine Learning     ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Unit 5 -->

        <Button
            android:id="@+id/unit5Button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:gravity="center_vertical|start"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="05    Evaluation Metrics and Ensemble Learning     ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Unit 6 -->

        <Button
            android:id="@+id/unit6Button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_unit_button"
            android:gravity="center_vertical|start"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="06    Hypothesis Design     ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Footer -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="LEARN THE CONCEPT. RUN THE ALGORITHM."
            android:textColor="#2563EB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Built for curious minds."
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
