<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNIT 02 • PLANNING"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Least Commitment Strategy"
            android:textColor="#172B4D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Learn how an AI planner preserves flexibility by delaying unnecessary decisions."
            android:textColor="#5B6578"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lcsScenarioText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#DBEAFE"
            android:text="Least Commitment Strategy"
            android:textColor="#1E3A8A"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PLANNING STATE"
            android:textColor="#172B4D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lcsPlanText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:text="The plan will appear here."
            android:textColor="#334155"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="WHY THIS STEP MATTERS"
            android:textColor="#172B4D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lcsExplanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="16dp"
            android:background="#DCFCE7"
            android:text="The explanation will appear here."
            android:textColor="#166534"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/lcsProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Ready to begin"
            android:textColor="#5B6578"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/lcsStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Start Planning" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/lcsPreviousButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous" />

            <Button
                android:id="@+id/lcsNextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Next" />

        </LinearLayout>

        <Button
            android:id="@+id/lcsCompareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Compare Strategies" />

        <TextView
            android:id="@+id/lcsComparisonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="16dp"
            android:background="#E0E7FF"
            android:text="The comparison will appear here."
            android:textColor="#1E3A8A"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/lcsResetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reset Demonstration" />

    </LinearLayout>
</ScrollView>
