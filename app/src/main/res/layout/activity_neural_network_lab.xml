<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNIT 03 • NEURAL NETWORKS"
            android:textColor="#4263A5"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Neural Network Training Lab"
            android:textColor="#172B4D"
            android:textSize="27sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore a multilayer neural network learning the XOR problem. Train the network and observe its weights, hidden activations, output and error."
            android:textColor="#52627A"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NETWORK ARCHITECTURE"
            android:textColor="#172B4D"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingBottom="8dp" />

        <com.example.aiml_project.DynamicNetworkDiagramView
            android:id="@+id/networkDiagramView"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Green connections = positive weights. Red connections = negative weights. Node values show activations."
            android:textColor="#52627A"
            android:textSize="12sp"
            android:paddingTop="8dp"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECT XOR INPUT"
            android:textColor="#172B4D"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingBottom="8dp" />

        <Spinner
            android:id="@+id/xorInputSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/networkPredictionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prediction: --"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/networkErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Training loss: --"
            android:textColor="#2459A9"
            android:textSize="15sp"
            android:background="#E4ECFA"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LEARNING RATE"
            android:textColor="#172B4D"
            android:textStyle="bold"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/networkLearningRateSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99"
            android:progress="29" />

        <TextView
            android:id="@+id/networkLearningRateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Learning rate: 0.30"
            android:textColor="#52627A"
            android:textSize="13sp"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/networkTrainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Train for 1 Epoch"
            android:textAllCaps="false"
            android:backgroundTint="#2459A9"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/networkResetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Network"
            android:textAllCaps="false"
            android:backgroundTint="#DCEAFE"
            android:textColor="#172B4D"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/networkExplanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forward propagation calculates the output. Backpropagation calculates how each weight contributed to the error and updates the weights to improve the prediction."
            android:textColor="#24364B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:background="#FFFFFF"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>
