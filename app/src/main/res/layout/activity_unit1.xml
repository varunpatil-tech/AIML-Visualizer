<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_dashboard_header">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIML VISUALIZER  /  MODULE 01"
                android:textColor="#B9E8FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Heuristic Search\nTechniques"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Teach AI to explore possibilities, evaluate choices, and find solutions."
                android:textColor="#E0F2FE"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_unit_number"
                android:text="6 ALGORITHMS"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Section heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Explore the algorithms"
            android:textColor="#172B4D"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="16dp"
            android:text="Select a topic to study its concepts and working."
            android:textColor="#66758A"
            android:textSize="14sp" />

        <!-- Algorithm 1 -->
        <Button
            android:id="@+id/hillClimbingButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="01   Hill Climbing"
            android:textAllCaps="false"
            android:textColor="#17365D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- Algorithm 2 -->
        <Button
            android:id="@+id/bestFirstButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="02   Best-First Search"
            android:textAllCaps="false"
            android:textColor="#17365D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- Algorithm 3 -->
        <Button
            android:id="@+id/meansEndsButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="03   Means-Ends Analysis"
            android:textAllCaps="false"
            android:textColor="#17365D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- Algorithm 4 -->
        <Button
            android:id="@+id/cspButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="04   Constraint Satisfaction"
            android:textAllCaps="false"
            android:textColor="#17365D"
            android:textSize="15sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- Algorithm 5 -->
        <Button
            android:id="@+id/aStarButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="05   A* Search"
            android:textAllCaps="false"
            android:textColor="#17365D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- Algorithm 6 -->
        <Button
            android:id="@+id/aoStarButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_unit_button"
            android:backgroundTint="@null"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="06   AO* Algorithm"
            android:textAllCaps="false"
            android:textColor="#17365D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="LEARN  •  EXPLORE  •  UNDERSTAND"
            android:textColor="#718096"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

    </LinearLayout>

</ScrollView>
