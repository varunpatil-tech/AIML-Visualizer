<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AO* Search Algorithm"
            android:textColor="#172554"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Explore AND/OR graphs, heuristic costs, and optimal solution selection."
            android:textColor="#475569"
            android:textSize="15sp" />

        <com.example.aiml_project.AOStarGraphView
            android:id="@+id/aoStarGraphView"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/aoStarStepText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#E0E7FF"
            android:text="Press Start to begin."
            android:textColor="#1E3A8A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aoStarExplanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:text="AO* uses heuristic estimates to choose the most promising subgraph."
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/aoStarCostText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:text="Costs will appear here."
            android:textColor="#166534"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startAOStarButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start" />

            <Button
                android:id="@+id/nextAOStarButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Next" />

            <Button
                android:id="@+id/resetAOStarButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Reset" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Legend: Green = selected solution, Orange = current node, Blue = other nodes. The B AND C branch requires both nodes."
            android:textColor="#475569"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
