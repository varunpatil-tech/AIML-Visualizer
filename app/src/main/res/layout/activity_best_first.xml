<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Greedy Best-First Search"
            android:textColor="#172554"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Explore the graph by choosing the node with the lowest heuristic value h(n)."
            android:textColor="#475569"
            android:textSize="15sp" />

        <com.example.aiml_project.BestFirstGraphView
            android:id="@+id/bestFirstGraphView"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#DBEAFE"
            android:padding="12dp"
            android:text="Press Start Search to begin."
            android:textColor="#1E3A8A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/explanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="The algorithm starts at S and searches for goal G."
            android:textColor="#334155"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="OPEN LIST"
            android:textColor="#166534"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/openListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#DCFCE7"
            android:padding="12dp"
            android:text="Empty"
            android:textColor="#14532D"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CLOSED LIST"
            android:textColor="#9A3412"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/closedListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFEDD5"
            android:padding="12dp"
            android:text="Empty"
            android:textColor="#7C2D12"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startSearchButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Search"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/nextStepButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Next Step"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/resetSearchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset Search"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="Remember: Greedy Best-First Search uses h(n) only. It does not consider the path cost g(n) when selecting the next node."
            android:textColor="#475569"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
