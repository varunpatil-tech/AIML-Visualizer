<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Constraint Satisfaction Problem"
            android:textColor="#172554"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Color each region so that adjacent regions have different colors. Follow the backtracking algorithm one step at a time."
            android:textColor="#475569"
            android:textSize="15sp" />

        <com.example.aiml_project.CSPGraphView
            android:id="@+id/cspGraphView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="VARIABLES"
            android:textColor="#1D4ED8"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#DBEAFE"
            android:padding="12dp"
            android:text="A, B, C, D"
            android:textColor="#1E3A8A"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="DOMAIN"
            android:textColor="#1D4ED8"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#DBEAFE"
            android:padding="12dp"
            android:text="Each region can use Red, Green, or Blue."
            android:textColor="#1E3A8A"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CONSTRAINTS"
            android:textColor="#7E22CE"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F3E8FF"
            android:padding="12dp"
            android:text="A ≠ B, A ≠ C, B ≠ C, B ≠ D, C ≠ D"
            android:textColor="#581C87"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cspStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E2E8F0"
            android:padding="12dp"
            android:text="Press Start Search to begin."
            android:textColor="#172554"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cspExplanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="Backtracking assigns a value, checks constraints, and returns to an earlier variable when necessary."
            android:textColor="#334155"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cspAssignmentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#DCFCE7"
            android:padding="12dp"
            android:text="Assignments will appear here."
            android:textColor="#14532D"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startCSPButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Search"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/nextCSPButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Next Step"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/resetCSPButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
