<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Means–Ends Analysis"
            android:textColor="#172554"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Compare the current state with the goal, identify the difference, and choose an action to reduce it."
            android:textColor="#475569"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CURRENT STATE"
            android:textColor="#1D4ED8"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.example.aiml_project.MeansEndsView
            android:id="@+id/meansEndsView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/currentStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#DBEAFE"
            android:padding="12dp"
            android:text="Current state"
            android:textColor="#1E3A8A"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="GOAL STATE"
            android:textColor="#15803D"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goalStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#DCFCE7"
            android:padding="12dp"
            android:text="Move all disks from peg A to peg C."
            android:textColor="#14532D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ANALYSIS"
            android:textColor="#7E22CE"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/differenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F3E8FF"
            android:padding="12dp"
            android:text="Difference between current state and goal."
            android:textColor="#581C87"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/actionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:text="Selected action will appear here."
            android:textColor="#92400E"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startMeansEndsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/nextMeansEndsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Next Step"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/resetMeansEndsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="Principle: identify the difference, select an operator that reduces it, satisfy any required subgoals, and repeat until the goal is reached."
            android:textColor="#475569"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
